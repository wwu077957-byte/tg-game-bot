# Use a dedicated Telegram bot token, or the existing token when replacing that bot.
BOT_TOKEN=replace-with-bot-token

# Telegram API application credentials from my.telegram.org (not the bot token).
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace-with-api-hash

# REQUIRED: numeric Telegram user IDs allowed to use this bot, comma-separated.
# Example only: 123456789,987654321
# An empty or invalid list prevents the bot from starting.
ALLOWED_TELEGRAM_USER_IDS=

# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Protect this key separately from the database and never commit it.
SESSION_ENCRYPTION_KEY=replace-with-generated-fernet-key

# Persistent path on a private disk; protect the directory and backups.
DATABASE_PATH=data/tg_manager.sqlite3
LOG_LEVEL=INFO
LOGIN_COOLDOWN_SECONDS=60

# Optional: only accounts with contextual_replies explicitly enabled use this key.
# Store the real value in the deployment platform's secret variables, never in Git.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
